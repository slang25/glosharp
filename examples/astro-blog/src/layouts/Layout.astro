---
// Hover popups, error annotations and completion lists. Without this
// stylesheet every popup renders inline as plain text.
import '@glosharp/shiki/style.css'

interface Props {
  title?: string
  frontmatter?: { title?: string }
}

// Pages pass `title`; Markdown posts using `layout:` pass their frontmatter.
const { title = Astro.props.frontmatter?.title ?? 'C# Blog' } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style is:global>
      body {
        font-family: system-ui, -apple-system, sans-serif;
        max-width: 48rem;
        margin: 2rem auto;
        padding: 0 1rem;
        line-height: 1.6;
        color: #1e1e1e;
        background: #fff;
      }

      pre {
        padding: 1rem;
        border-radius: 0.5rem;
        overflow-x: auto;
      }

      /* Astro renders both Shiki themes as CSS variables; switch to the dark
         one when the reader prefers it. Only token spans carry the variables
         inline, which keeps the popups' own colours intact. */
      @media (prefers-color-scheme: dark) {
        body {
          color: #d4d4d4;
          background: #1e1e1e;
        }

        .astro-code {
          color: var(--shiki-dark) !important;
          background-color: var(--shiki-dark-bg) !important;
        }

        .astro-code span[style*='--shiki-dark'] {
          color: var(--shiki-dark) !important;
        }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
