<Project>

  <!--
    The release version of everything Glo# ships: GloSharp.Core, GloSharp.Cli (and so
    what its version flag reports) and, stamped from here by scripts/version.mjs, the
    @glosharp/* npm packages. Don't edit it by hand: `npm run version:set <version>` also
    updates the package.json files, package-lock.json and the CLI version @glosharp/core
    expects, and CI fails if they drift. Pushing the tag v<Version> releases it (see
    CONTRIBUTING.md).

    It lives in src/ rather than at the repository root so the test fixture projects and
    the snippet projects glosharp compiles don't inherit it.
  -->
  <PropertyGroup>
    <Version>0.1.0-alpha.2</Version>
  </PropertyGroup>

</Project>
